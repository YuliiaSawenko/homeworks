
var services = { // створюємо обєкт з переліком послуг
  "стрижка": "60 грн",
  "гоління": "80 грн",
  "Миття голови": "100 грн"
};

services["манікюр"] = "500 грн"; // додаємо нові послуги
services["ламінування вій"] = "750 грн";
services["корекція брів"] = "350 грн";
services["педікюр"] = "650 грн";

// використовуємо метод щоб порахувати загальну вартість послуг
services.price = function() { 
  var total = 0;

  for (var key in this) {
    if (typeof this[key] === "string") { 
      total += parseInt(this[key]); // використовуємо parseInt щоб отримувати числові значення
    }
  }

  return total;
};
// використовуємо метод для знаходження мінімальної ціни
services.minPrice = function() {
  var min = 9999; // беремо число щоб будь-яка наша реальна ціна була менша за нього.

  for (var key in this) {
    if (typeof this[key] === "string") {
      var price = parseInt(this[key]);
      if (price < min) {
        min = price;
      }
    }
  }

  return min;
};
// використовуємо метод для знаходження максимальної ціни
services.maxPrice = function() {
  var max = 0; // беремо нуль бо він буде меньше ніж будь яка наша ціна

  for (var key in this) {
    if (typeof this[key] === "string") {
      var price = parseInt(this[key]);
      if (price > max) {
        max = price;
      }
    }
  }

  return max;
};

console.log("Загальна вартість:", services.price() + " грн");
console.log("Мінімальна ціна:", services.minPrice() + " грн");
console.log("Максимальна ціна:", services.maxPrice() + " грн");
