	"item": [
		{
			"name": "IsValidISBN13",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const response = pm.response.text();",
							"const headers = pm.response.headers;",
							"",
							"pm.test(\"Response received\", () => {",
							"    pm.expect(response).to.not.be.empty;",
							"});",
							"",
							"pm.test(\"Status code is 200 or 400\", () => {",
							"    pm.expect([200, 400]).to.include(pm.response.code);",
							"});",
							"",
							"pm.test(\"Response contains SOAP Envelope\", () => {",
							"    pm.expect(response).to.include(\"Envelope\");",
							"});",
							"",
							"pm.test(\"Response contains Body\", () => {",
							"    pm.expect(response).to.include(\"Body\");",
							"});",
							"",
							"pm.test(\"Response contains ISBN\", () => {",
							"    pm.expect(response).to.include(\"ISBN\");",
							"});",
							"",
							"pm.test(\"Content-Type header exists\", () => {",
							"    pm.expect(headers.has(\"Content-Type\")).to.be.true;",
							"});",
							"",
							"pm.test(\"Date header exists\", () => {",
							"    pm.expect(headers.has(\"Date\")).to.be.true;",
							"});",
							"",
							"pm.test(\"Server header exists\", () => {",
							"    pm.expect(headers.has(\"Server\")).to.be.true;",
							"});",
							"",
							"pm.test(\"Response time < 3000ms\", () => {",
							"    pm.expect(pm.response.responseTime).to.be.below(3000);",
							"});",
							"",
							"pm.test(\"No empty SOAP response\", () => {",
							"    pm.expect(response.length).to.be.above(50);",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
